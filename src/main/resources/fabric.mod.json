{
  "schemaVersion": 1,
  "id": "e4mc_voice_compat",
  "version": "${version}",
  "name": "e4mc Voice Compat",
  "description": "Makes Simple Voice Chat work for players joining through e4mc by tunneling voice packets through the Minecraft connection.",
  "authors": [
    "Heet"
  ],
  "license": "MIT",
  "icon": {
    "64": "logo-64.png",
    "128": "logo-128.png"
  },
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.heet.e4mcvoice.E4mcVoiceCompat"
    ],
    "client": [
      "io.github.heet.e4mcvoice.client.E4mcVoiceCompatClient"
    ],
    "voicechat": [
      "io.github.heet.e4mcvoice.E4mcVoicePlugin"
    ]
  },
  "mixins": [
    "e4mc_voice_compat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}.x",
    "java": ">=25",
    "fabric-api": "*",
    "e4mc": "*",
    "voicechat": ">=2.6.22"
  }
}
